EXPO_PUBLIC_API_URL=https://backend.usekollecta.com
# EXPO_PUBLIC_API_URL=http://192.168.1.224:3011/api

# Une seule app sert toutes les organisations : l'utilisateur choisit la
# sienne au premier lancement (écran select-organization), stockée ensuite
# en SecureStore et envoyée via X-Tenant-Domain sur chaque appel API. Ceci
# ne fait que pré-remplir le champ, ce n'est plus une valeur figée.
EXPO_PUBLIC_TENANT_DOMAIN=crea-invest.usekollecta.com