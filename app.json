{
  "expo": {
    "name": "CREA Collections",
    "slug": "crea-collections",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "crea-collections",
    "splash": {
      "image": "./assets/crea-invest-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CREA Collections a besoin de votre position pour valider les opérations dans votre zone.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.overskilled.creacollections"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#cb1011"
      },
      "edgeToEdgeEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.overskilled.creacollections"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CREA Collections a besoin de votre position pour valider les opérations."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dfbba137-5535-4cb0-9d70-573021b7981a"
      }
    },
    "owner": "overskilled"
  }
}
